    "./tenant": "./src/tenant/index.ts",
    "./query": "./src/query/index.ts"
  },
  "dependencies": {
    "@volo/abp-react-app-config": "^10.6.0",
    "@volo/abp-react-oidc-auth": "^10.6.0",
