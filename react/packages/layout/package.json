{
  "name": "@acrostack/layout",
  "version": "0.0.0",
  "private": true,
  "description": "应用外壳（AppShell / 侧边栏 / 面包屑 / 主题），刻意与路由库无关：导航数据由宿主传入，链接渲染经 renderLink 注入",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./primitives": "./src/primitives.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@acrostack/ui": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@acrostack/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
