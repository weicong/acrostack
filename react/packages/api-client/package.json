  },
  "devDependencies": {
    "@kubb/plugin-axios": "^5.2.2",
    "@kubb/plugin-react-query": "^5.0.3",
    "@kubb/plugin-ts": "^5.0.1",
    "@types/react": "^19.2.18",
    "kubb": "^5.1.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0"
  }
}
