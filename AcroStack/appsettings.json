{
  "App": {
    "SelfUrl": "https://localhost:44317",
    "ReactUrl": "http://localhost:5173",
    "CorsOrigins": "https://*.AcroStack.com,http://localhost:5173,",
    "RedirectAllowedUrls": "http://localhost:5173,",
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Data Source=AcroStack.db;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44317",
    "SwaggerClientId": "AcroStack_Swagger",
    "CertificatePassPhrase": "fb154108-8320-45ec-b081-fda4942fcf1f"
  },
  "Settings": {
    "Abp.Identity.Password.RequireNonAlphanumeric": "false",
    "Abp.Identity.Password.RequireLowercase": "false",
    "Abp.Identity.Password.RequireUppercase": "false",
    "Abp.Identity.Password.RequireDigit": "false"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "thY25b64sOkUQ01b"
  },
  "AdminConsole": {
    "IsEnabled": true,
    "RedirectRootToAdminConsole": true,
    "Authority": "https://localhost:44317",
    "ClientId": "AcroStack_AdminConsole",
    "Scope": "openid profile email offline_access AcroStack",
    "LocalizationLanguages": ["en", "ar", "zh-Hans", "zh-Hant", "cs", "en-GB", "fi", "fr", "de-DE", "hi", "hu", "is", "it", "pt-BR", "ro-RO", "ru", "sk", "es", "sv", "tr"],
    "ThemeOverrideCssPath": "/theme-override.css",
    "InitialTheme": "",
    "CustomizationPermissionName": "AdminConsole.Customization"
  },
  "OpenIddict": {
    "Applications": {
      "AcroStack_App": {
        "ClientId": "AcroStack_App",
        "RootUrl": "http://localhost:5173"
      },
      "AcroStack_Swagger": {
        "ClientId": "AcroStack_Swagger",
        "RootUrl": "https://localhost:44317"
      },
      "AcroStack_AdminConsole": {
        "ClientId": "AcroStack_AdminConsole",
        "RootUrl": "https://localhost:44317/admin-console"
      }
    }
  }
}
