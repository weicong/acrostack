<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AcroStack.AuditLogging</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Application" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Authorization" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.AuditLogging.Domain" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.BackgroundWorkers" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Localization" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Validation" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.9" />
    <PackageReference Include="MiniExcel" Version="1.45.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\AuditLogging\*.json" />
  </ItemGroup>
</Project>
