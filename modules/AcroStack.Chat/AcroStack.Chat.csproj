<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AcroStack.Chat</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Application" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Authorization" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.BlobStoring" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.MultiTenancy" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Mapperly" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Localization" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Validation" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AcroStack.AppUsers\AcroStack.AppUsers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Chat\*.json" />
  </ItemGroup>
</Project>
