{
  "name": "@acrostack/tanstack-form-antd",
  "version": "0.1.0",
  "description": "Ant Design v6 × TanStack Form Adapter - Type-safe form components",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@tanstack/react-form": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "antd": "catalog:",
    "dayjs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-form": ">=1",
    "antd": ">=6",
    "react": ">=18",
    "react-dom": ">=18"
  }
}
